{
  "name": "certificate-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "bun --watch server/src/index.ts",
    "dev:web": "bun run --cwd web dev",
    "migrate": "bun server/src/migrate.ts",
    "auth:generate": "bunx --bun auth generate --config server/src/auth-cli.ts --output server/src/db/auth-schema.ts -y",
    "db:generate": "bunx --bun drizzle-kit generate",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "bun test server/test",
    "build:web": "bun run --cwd web build"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/pg": "8.23.1",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "typescript": "5"
  },
  "overrides": {
    "express": "5.2.1"
  },
  "workspaces": [
    "web"
  ]
}
