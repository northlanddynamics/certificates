{
  "name": "certificate-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "bun --watch server/src/index.ts",
    "dev:web": "bun run --cwd web dev",
    "migrate": "bun server/src/platform/migrate.ts",
    "contract:export": "bun server/src/agents/agent-contract-export.ts",
    "auth:generate": "bunx --bun auth generate --config server/src/tenancy/auth-cli.ts --output server/src/platform/db/auth-schema.ts -y",
    "db:generate": "bunx --bun drizzle-kit generate",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "bun test server/test",
    "build:web": "bun run --cwd web build"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@better-auth/sso": "1.7.7",
    "@hono/zod-openapi": "1.6.3",
    "@peculiar/x509": "1.14.3",
    "@scalar/hono-api-reference": "^0.12.11",
    "acme-client": "5.4.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "ts-scep": "file:./vendor/ts-scep",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/pg": "8.23.1",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "jose": "6.2.12",
    "samlify": "2.13.1",
    "typescript": "5"
  },
  "overrides": {
    "express": "5.2.1",
    "@peculiar/asn1-schema": "2.11.0"
  },
  "workspaces": [
    "web"
  ]
}
