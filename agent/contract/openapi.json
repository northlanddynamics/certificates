{
  "openapi": "3.1.0",
  "info": {
    "title": "Certificate Platform Agent protocol",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "agentCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "The Agent's credential, from Agent Registration or its latest rotation."
      }
    },
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/api/agent/registration": {
      "post": {
        "tags": [
          "Agent protocol"
        ],
        "summary": "Agent Registration: bind a newly installed Agent to an Organization with a single-use token",
        "description": "The token is the one an Organization Administrator made for the Organization; it is used up by this call, and used or expired ones are refused. The response holds the Agent's credential, which it keeps and presents from then on (ADR 0006); the platform keeps only its hash, so it is not shown again.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "hostName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "os": {
                    "type": "string",
                    "enum": [
                      "linux",
                      "windows",
                      "macos"
                    ]
                  },
                  "arch": {
                    "type": "string",
                    "enum": [
                      "amd64",
                      "arm64"
                    ]
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "required": [
                  "token",
                  "hostName",
                  "os",
                  "arch",
                  "version"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "credential": {
                      "type": "string",
                      "description": "The Agent's credential, sent as `Authorization: Bearer <credential>`. It is shown only in this response: the platform keeps only its hash."
                    },
                    "expiresAt": {
                      "type": "string",
                      "description": "When it ends. The Agent rotates it once a third of its life is left."
                    },
                    "agentId": {
                      "type": "string"
                    },
                    "pollAfterSeconds": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "credential",
                    "expiresAt",
                    "agentId",
                    "pollAfterSeconds"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/poll": {
      "post": {
        "tags": [
          "Agent protocol"
        ],
        "summary": "Heartbeat: report the version and receive work items",
        "description": "An Agent calls this every `pollAfterSeconds`. Each call is its contact with the platform: it is how its last contact, its version and so its online status are known.",
        "security": [
          {
            "agentCredential": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "required": [
                  "version"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "description": "What the Agent is asked to do; an Agent ignores a type it does not know. `dns.present`, `dns.cleanup` and `dns.test` are DNS Provider operations the Agent relays: the payload has `provider` (`type`, its `settings` and its `secret`, the credentials, which the Agent uses for this operation only) and, but for `dns.test`, the TXT `record` (`name`, `value`). `deployment.generate_key` asks the Agent to make a private key for a Managed Certificate in a store only its service account can read, and to report a CSR for it (never the key): the payload has `deploymentId`, `managedCertificateId`, `names` and `keyAlgorithm`: `ecdsa-p256`, `ecdsa-p384`, `rsa-2048`, `rsa-3072`, `rsa-4096`, or `ml-dsa-44`, `ml-dsa-65`, `ml-dsa-87` (pure ML-DSA with an empty context, as RFC 9881 has it in X.509). An Agent that does not make the algorithm fails the item with a reason. `deployment.run` gives the Agent a Certificate and a Deployment Script to run for it: the payload has `deploymentId`, `managedCertificateId`, `trigger`, `names`, the `certificate` (`id`, `fingerprint`, `notAfter`, `chainPem`: the leaf then the intermediates) and the `script` (`name`, `interpreter`, `version`, `hash`, `content`). The Agent runs the script only if the SHA-256 of its content is the hash, and reports how it went. The Agent reports how it went to `POST /api/agent/work-items/{id}/result`."
                          },
                          "payload": {
                            "type": "object",
                            "additionalProperties": {}
                          }
                        },
                        "required": [
                          "id",
                          "type",
                          "payload"
                        ]
                      }
                    },
                    "pollAfterSeconds": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "items",
                    "pollAfterSeconds"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/work-items/{id}/result": {
      "post": {
        "tags": [
          "Agent protocol"
        ],
        "summary": "Report how a work item went",
        "description": "Once, by the Agent the item was given to. An item whose requester stopped waiting for the Agent (it was too slow, so another was asked) is refused with a 409, as is one already reported on.",
        "security": [
          {
            "agentCredential": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ok": {
                    "type": "boolean"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "rejected",
                      "unreachable"
                    ],
                    "description": "When a DNS Provider operation failed: `rejected` if the DNS service answered and said no, `unreachable` if it did not answer."
                  },
                  "error": {
                    "type": "string",
                    "maxLength": 1000,
                    "description": "What went wrong, for a person to read. It must not contain the credentials."
                  },
                  "csr": {
                    "type": "string",
                    "maxLength": 64000,
                    "description": "For `deployment.generate_key`: a PEM CSR for the key the Agent made, for the names and key algorithm it was given. The key is never sent."
                  },
                  "run": {
                    "type": "object",
                    "properties": {
                      "startedAt": {
                        "type": "string"
                      },
                      "finishedAt": {
                        "type": "string"
                      },
                      "exitCode": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "description": "The script's exit code; none when it was not started, which it is not when its content does not match its hash."
                      },
                      "output": {
                        "type": "string",
                        "maxLength": 65536,
                        "description": "What the script wrote to its standard output and error, cut to 32 KiB; when it was not started, why."
                      },
                      "outputTruncated": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "startedAt",
                      "finishedAt",
                      "exitCode",
                      "output",
                      "outputTruncated"
                    ],
                    "description": "For `deployment.run`: how the script went. `ok` is whether it succeeded (exit code 0)."
                  }
                },
                "required": [
                  "ok"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "received": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "received"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/credential": {
      "post": {
        "tags": [
          "Agent protocol"
        ],
        "summary": "Rotate the Agent's credential",
        "description": "The Agent receives a new credential, which replaces the one it presented. That one stays accepted until the new one is first used, so an Agent that never received the response can try again.",
        "security": [
          {
            "agentCredential": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "credential": {
                      "type": "string",
                      "description": "The Agent's credential, sent as `Authorization: Bearer <credential>`. It is shown only in this response: the platform keeps only its hash."
                    },
                    "expiresAt": {
                      "type": "string",
                      "description": "When it ends. The Agent rotates it once a third of its life is left."
                    }
                  },
                  "required": [
                    "credential",
                    "expiresAt"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
