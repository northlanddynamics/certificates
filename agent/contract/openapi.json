{
  "openapi": "3.1.0",
  "info": {
    "title": "Certificate Platform Agent protocol",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "agentCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "The Agent's credential, from Agent Registration or its latest rotation."
      }
    },
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/api/agent/registration": {
      "post": {
        "tags": [
          "Agent protocol"
        ],
        "summary": "Agent Registration: bind a newly installed Agent to an Organization with a single-use token",
        "description": "The token is the one an Organization Administrator made for the Organization; it is used up by this call, and used or expired ones are refused. The response holds the Agent's credential, which it keeps and presents from then on (ADR 0006); the platform keeps only its hash, so it is not shown again.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "hostName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "os": {
                    "type": "string",
                    "enum": [
                      "linux",
                      "windows",
                      "macos"
                    ]
                  },
                  "arch": {
                    "type": "string",
                    "enum": [
                      "amd64",
                      "arm64"
                    ]
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "required": [
                  "token",
                  "hostName",
                  "os",
                  "arch",
                  "version"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "credential": {
                      "type": "string",
                      "description": "The Agent's credential, sent as `Authorization: Bearer <credential>`. It is shown only in this response: the platform keeps only its hash."
                    },
                    "expiresAt": {
                      "type": "string",
                      "description": "When it ends. The Agent rotates it once a third of its life is left."
                    },
                    "agentId": {
                      "type": "string"
                    },
                    "pollAfterSeconds": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "credential",
                    "expiresAt",
                    "agentId",
                    "pollAfterSeconds"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/poll": {
      "post": {
        "tags": [
          "Agent protocol"
        ],
        "summary": "Heartbeat: report the version and receive work items",
        "description": "An Agent calls this every `pollAfterSeconds`. Each call is its contact with the platform: it is how its last contact, its version and so its online status are known.",
        "security": [
          {
            "agentCredential": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "required": [
                  "version"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "description": "What the Agent is asked to do; an Agent ignores a type it does not know. `dns.present`, `dns.cleanup` and `dns.test` are DNS Provider operations the Agent relays: the payload has `provider` (`type`, its `settings` and its `secret`, the credentials, which the Agent uses for this operation only) and, but for `dns.test`, the TXT `record` (`name`, `value`). `deployment.generate_key` asks the Agent to make a private key for a Managed Certificate in a store only its service account can read, and to report a CSR for it (never the key): the payload has `deploymentId`, `managedCertificateId`, `names` and `keyAlgorithm`: `ecdsa-p256`, `ecdsa-p384`, `rsa-2048`, `rsa-3072`, `rsa-4096`, or `ml-dsa-44`, `ml-dsa-65`, `ml-dsa-87` (pure ML-DSA with an empty context, as RFC 9881 has it in X.509). An Agent that does not make the algorithm fails the item with a reason. `deployment.run` gives the Agent a Certificate and a Deployment Script to run for it: the payload has `deploymentId`, `managedCertificateId`, `trigger`, `names`, the `certificate` (`id`, `fingerprint`, `notAfter`, `chainPem`: the leaf then the intermediates), the `script` (`name`, `interpreter`, `version`, `hash`, `content`) and `parameters`, the Deployment's parameter values by name (an object of strings, empty when it has none), which the Agent gives the script as environment variables named `DEPLOY_PARAM_` and the name. The Agent runs the script only if the SHA-256 of its content is the hash, and reports how it went. `adcs.discover` asks the Agent to reach an ADCS CA with MS-WCCE, as its own account, and to report the CA's certificate chain and its Certificate Templates with their facts, as `discovery`: the payload has `configString`, the CA's `host\\CA Name`. `adcs.submit` asks the Agent to submit a CSR to an ADCS CA with MS-WCCE, as its own account, under a Certificate Template, and to report what ADCS answered as `submission`: the payload has `configString`, `template` (the template's ADCS name) and `csr` (PEM). ADCS may issue it (`issued`), hold it for a CA manager's approval (`pending`) or deny it (`denied`). `adcs.check` asks the Agent to ask an ADCS CA again where a request it held pending stands, and to report it as `submission`, in the same shape: the payload has `configString` and `requestId`, ADCS's ID of the request. `adcs.revoke` asks the Agent to have an ADCS CA revoke a Certificate it issued, and to report `revocation` (`status`: `revoked`) once it has, or had already: the payload has `configString`, `serialNumber` (hex) and `reason`, the RFC 5280 CRLReason code, which ADCS takes as its own. An Agent that cannot reach ADCS (one not on Windows) fails an ADCS item as `rejected`, saying so; one whose CA does not answer fails it as `unreachable`, and the platform asks another; ADCS refusing the request is `rejected`, with its reason. The Agent reports how it went to `POST /api/agent/work-items/{id}/result`."
                          },
                          "payload": {
                            "type": "object",
                            "additionalProperties": {}
                          }
                        },
                        "required": [
                          "id",
                          "type",
                          "payload"
                        ]
                      }
                    },
                    "pollAfterSeconds": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "items",
                    "pollAfterSeconds"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/work-items/{id}/result": {
      "post": {
        "tags": [
          "Agent protocol"
        ],
        "summary": "Report how a work item went",
        "description": "Once, by the Agent the item was given to. An item whose requester stopped waiting for the Agent (it was too slow, so another was asked) is refused with a 409, as is one already reported on.",
        "security": [
          {
            "agentCredential": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ok": {
                    "type": "boolean"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "rejected",
                      "unreachable"
                    ],
                    "description": "When a DNS Provider or ADCS operation failed: `rejected` if the DNS service or ADCS answered and said no, `unreachable` if it did not answer."
                  },
                  "error": {
                    "type": "string",
                    "maxLength": 1000,
                    "description": "What went wrong, for a person to read. It must not contain the credentials."
                  },
                  "csr": {
                    "type": "string",
                    "maxLength": 64000,
                    "description": "For `deployment.generate_key`: a PEM CSR for the key the Agent made, for the names and key algorithm it was given. The key is never sent."
                  },
                  "run": {
                    "type": "object",
                    "properties": {
                      "startedAt": {
                        "type": "string"
                      },
                      "finishedAt": {
                        "type": "string"
                      },
                      "exitCode": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "description": "The script's exit code; none when it was not started, which it is not when its content does not match its hash."
                      },
                      "output": {
                        "type": "string",
                        "maxLength": 65536,
                        "description": "What the script wrote to its standard output and error, cut to 32 KiB; when it was not started, why."
                      },
                      "outputTruncated": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "startedAt",
                      "finishedAt",
                      "exitCode",
                      "output",
                      "outputTruncated"
                    ],
                    "description": "For `deployment.run`: how the script went. `ok` is whether it succeeded (exit code 0)."
                  },
                  "discovery": {
                    "type": "object",
                    "properties": {
                      "chain": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 32768
                        },
                        "minItems": 1,
                        "maxItems": 10,
                        "description": "The CA certificate (PEM), then each certificate above it up to its root, the one that signs it first."
                      },
                      "templates": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 255,
                              "description": "Its ADCS name (common name), which requests name it by."
                            },
                            "oid": {
                              "type": "string",
                              "maxLength": 255,
                              "pattern": "^\\d+(\\.\\d+)+$"
                            },
                            "displayName": {
                              "type": "string",
                              "maxLength": 255
                            },
                            "extendedKeyUsages": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "maxLength": 255,
                                "pattern": "^\\d+(\\.\\d+)+$"
                              },
                              "maxItems": 50,
                              "description": "Its EKUs, as OIDs."
                            },
                            "validityDays": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 36500,
                              "description": "How long what it issues is valid for, in days."
                            },
                            "minimumKeySize": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 16384,
                              "description": "The smallest key it takes, in bits."
                            },
                            "keyAlgorithms": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "enum": [
                                  "rsa",
                                  "ecdsa-p256",
                                  "ecdsa-p384",
                                  "ecdsa-p521"
                                ]
                              },
                              "maxItems": 4,
                              "description": "The key algorithms it allows."
                            },
                            "managerApproval": {
                              "type": "boolean",
                              "description": "Whether a request under it waits for a CA manager's approval."
                            },
                            "subjectFromRequest": {
                              "type": "boolean",
                              "description": "Whether it is set to \"Supply in the request\", rather than building the subject from Active Directory."
                            },
                            "enrollable": {
                              "type": "boolean",
                              "description": "Whether the Agent's account may enroll on it."
                            },
                            "published": {
                              "type": "boolean",
                              "description": "Whether the CA publishes it."
                            }
                          },
                          "required": [
                            "name",
                            "oid",
                            "displayName",
                            "extendedKeyUsages",
                            "validityDays",
                            "minimumKeySize",
                            "keyAlgorithms",
                            "managerApproval",
                            "subjectFromRequest",
                            "enrollable",
                            "published"
                          ]
                        },
                        "maxItems": 500,
                        "description": "Each Certificate Template the CA publishes, with its facts."
                      }
                    },
                    "required": [
                      "chain",
                      "templates"
                    ],
                    "description": "For `adcs.discover`: what the Agent found at the ADCS CA."
                  },
                  "submission": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "issued"
                            ],
                            "description": "`issued`: ADCS issued the Certificate."
                          },
                          "requestId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64,
                            "description": "ADCS's ID of the request."
                          },
                          "certificate": {
                            "type": "string",
                            "maxLength": 32768,
                            "description": "The Certificate ADCS issued, PEM."
                          }
                        },
                        "required": [
                          "status",
                          "requestId",
                          "certificate"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "pending"
                            ],
                            "description": "`pending`: ADCS holds the request for a CA manager's approval; the platform asks again with `adcs.check`."
                          },
                          "requestId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64,
                            "description": "ADCS's ID of the request."
                          }
                        },
                        "required": [
                          "status",
                          "requestId"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "denied"
                            ],
                            "description": "`denied`: ADCS denied the request, a CA manager or its policy."
                          },
                          "requestId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64,
                            "description": "ADCS's ID of the request."
                          },
                          "message": {
                            "type": "string",
                            "maxLength": 1024,
                            "description": "ADCS's disposition message: why it denied the request."
                          }
                        },
                        "required": [
                          "status",
                          "requestId",
                          "message"
                        ]
                      }
                    ],
                    "description": "For `adcs.submit` and `adcs.check`: what ADCS answered the request with, or holds it as now."
                  },
                  "revocation": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "string",
                        "enum": [
                          "revoked"
                        ],
                        "description": "`revoked`: ADCS revoked the Certificate, or had already."
                      }
                    },
                    "required": [
                      "status"
                    ],
                    "description": "For `adcs.revoke`: that ADCS revoked the Certificate. A refusal or a CA that does not answer is reported as a failure, `rejected` or `unreachable`."
                  }
                },
                "required": [
                  "ok"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "received": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "received"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/credential": {
      "post": {
        "tags": [
          "Agent protocol"
        ],
        "summary": "Rotate the Agent's credential",
        "description": "The Agent receives a new credential, which replaces the one it presented. That one stays accepted until the new one is first used, so an Agent that never received the response can try again.",
        "security": [
          {
            "agentCredential": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "credential": {
                      "type": "string",
                      "description": "The Agent's credential, sent as `Authorization: Bearer <credential>`. It is shown only in this response: the platform keeps only its hash."
                    },
                    "expiresAt": {
                      "type": "string",
                      "description": "When it ends. The Agent rotates it once a third of its life is left."
                    }
                  },
                  "required": [
                    "credential",
                    "expiresAt"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
